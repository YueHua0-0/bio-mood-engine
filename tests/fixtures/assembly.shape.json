{
  "contract": "00-统一契约 v1.7.14；字段表来源 05/06/07/08/09/10/11 §4.2",
  "tables_unchanged_since": "v1.7.14",
  "tables_unchanged_reason": "v1.7.14 只改 05 §5.3 的九维 phase_impact 输出层和 09 §5.2 的 cycle contribution 公式，不改任何模块 §4.2 inputs 键集（W3-3 不触发）；上一次 inputs 变更为 v1.7.13 前的 v1.7.6 为 08/09 的 inputs 增加 dt",
  "note": "keys 必须与实测 inputs 的键集完全相等；optional 为允许缺省的键（缺省时不得出现在键集中）；nested.path 用点号寻址。",
  "modules": {
    "cycle": {
      "keys": []
    },
    "sleep": {
      "keys": ["urgent", "urgent_interrupt", "event_intensity", "planned_wake_at"]
    },
    "stress": {
      "keys": ["event", "activity"],
      "nested": [
        { "path": "activity", "keys": ["last_event_at", "recent_event_ids"] }
      ]
    },
    "event": {
      "keys": ["event", "activity"],
      "nested": [
        { "path": "activity", "keys": ["last_event_at", "recent_event_ids"] }
      ]
    },
    "regulation": {
      "keys": ["cycle", "sleep", "stress", "mood", "dt"],
      "nested": [
        { "path": "cycle", "keys": ["phase"] },
        { "path": "sleep", "keys": ["sleep_debt", "sleep_quality", "sleepiness"] },
        { "path": "stress", "keys": ["level", "active_events"] },
        { "path": "mood", "keys": ["energy", "stability", "closeness_need"] }
      ]
    },
    "mood": {
      "keys": ["cycle", "sleep", "stress", "regulation", "event", "dt"],
      "nested": [
        { "path": "cycle", "keys": ["phase", "scalars"], "optional": ["phase_vector"] },
        { "path": "cycle.scalars", "keys": ["cycle_sensitivity"] },
        { "path": "sleep", "keys": ["sleep_debt", "sleep_quality", "sleepiness"] },
        { "path": "stress", "keys": ["level"] },
        {
          "path": "regulation",
          "keys": [
            "reward_sensitivity",
            "arousal",
            "threat_sensitivity",
            "calm_regulation",
            "social_reassurance_drive",
            "fatigue_load"
          ]
        },
        { "path": "event", "keys": ["intensity"] }
      ]
    },
    "behavior": {
      "keys": ["mood", "sleep", "stress", "now"],
      "nested": [
        {
          "path": "mood",
          "keys": ["energy", "stability", "sensitivity", "social_drive", "closeness_need", "physical_comfort"]
        },
        { "path": "sleep", "keys": ["state", "sleepiness", "sleep_debt"] },
        { "path": "stress", "keys": ["level"] }
      ]
    },
    "delivery": {
      "keys": ["event", "sleep", "queue"],
      "nested": [
        { "path": "event", "keys": ["event_type", "is_mentioned", "event_id", "conversation_id"] },
        { "path": "sleep", "keys": ["state", "sleepiness", "sleep_debt", "planned_wake_at"] },
        { "path": "queue", "keys": ["pending"] }
      ]
    }
  }
}
